<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Format A5 portrait : le standard des étiquettes logistiques palettes. -->
    <record id="paperformat_pallet_label" model="report.paperformat">
        <field name="name">Étiquette palette A5</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">148</field>
        <field name="page_height">210</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_pallet_label" model="ir.actions.report">
        <field name="name">Étiquette palette SSCC</field>
        <field name="model">stock.quant.package</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">wms_custom.report_pallet_label</field>
        <field name="report_file">wms_custom.report_pallet_label</field>
        <field name="paperformat_id" ref="paperformat_pallet_label"/>
        <field name="print_report_name">'Palette - %s' % object.name</field>
        <field name="binding_model_id" ref="stock.model_stock_quant_package"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
